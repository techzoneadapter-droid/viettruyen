{
  "name": "viettruyen",
  "version": "1.0.0",
  "description": "Không gian viết truyện dài bằng AI, lưu riêng trên máy",
  "author": "techzoneadapter-droid",
  "license": "GPL-3.0-only",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "release": "electron-builder --win nsis --x64 --publish always",
    "test:desktop": "node tests/desktop-smoke.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "fflate": "^0.8.3",
    "jose": "^6.1.0",
    "sharp": "^0.35.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12",
    "playwright-core": "^1.63.0"
  },
  "build": {
    "appId": "vn.viettruyen.desktop",
    "productName": "VietTruyen",
    "artifactName": "VietTruyen-Setup-${version}.${ext}",
    "files": [
      "desktop/**/*",
      "package.json",
      "LICENSE",
      "NOTICE.md"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "techzoneadapter-droid",
      "repo": "viettruyen",
      "releaseType": "release"
    }
  }
}
